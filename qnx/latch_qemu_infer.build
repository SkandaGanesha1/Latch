################################################################################
# qnx/latch_qemu_infer.build
#
# QNX SDP 8.0 OS Image Buildfile for the EXPERIMENTAL IN-GUEST INFERENCE
# profile on QEMU AArch64 (ARMv8 Virt Machine).
#
# Target Platform : QEMU `virt` machine (ARM Cortex-A76, GICv2, VirtIO, EL2 VHE)
# Hypervisor      : QNX Hypervisor 8.0 (AArch64 EL2 + GICv2 0x08000000 / 0x08010000)
#
# WHAT THIS PROFILE IS
# --------------------
# The scripted GOVERNOR profile (latch_qemu_governor.build) drives the plant
# from a FIXED sequence of frames compiled into the guest policy.  This
# profile drives it from a LANGUAGE MODEL that runs INSIDE the guest:
#
#     PID 1 (freestanding /init)  --owns-->  /dev/hvc0  (the black channel)
#        |
#        |  pipe carrying 32-byte wire-v2 frames
#        v
#     latch_infer  (a static AArch64 C++ binary: llama.cpp + the action
#                   schema validator)   -- reads the model from /dev/vda
#
# WHAT IT IS NOT
# --------------
# This is an EXPERIMENTAL bring-up profile, exactly like the GOVERNOR profile
# it is derived from.  QNX does not document QEMU TCG as a supported
# Hypervisor host platform.
#
# It is judged by the SAME SIGNED CONTRACT as the scripted profile:
# `contracts/governor_servo.manifest`, byte for byte.  No safety parameter
# is relaxed, and the manifest loader's 100-tick lease cap is respected --
# the guest policy holds that lease with heartbeats instead of asking the
# trusted host for more time.
#
# THE MODEL IS NOT IN THE REPOSITORY
# ----------------------------------
# The model and the inference program travel on a read-only virtio-blk disk
# image built by `tools/build_guest_disk.sh` and passed in as ${GUEST_DISK}.
# They are BUILD INPUTS, like the guest kernel Image (${GUEST_IMAGE}).
#
# The assets are NOT in the guest initramfs, and that is a measured
# constraint rather than a preference: qvm transfers a guest blob above a
# size threshold in 64 KiB message-block chunks that the GUEST has to
# service, and that service code lives in the QNX guest BSP, not in
# upstream Linux.  See guest/latch_guest_init.c for the measured symptom.
################################################################################

[image=0x40080000]
[virtual=aarch64le,raw] boot = {
    startup-qemu-virt -v -Q enable
    PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll:/lib/dll/qvm
    procnto-smp-instr -v
}

[+script] startup-script = {
    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    # 1. Serial console (PL011 UART at 0x09000000, IRQ 33 on QEMU virt)
    devc-serpl011 -e -F -b115200 0x09000000,33
    waitfor /dev/ser1 4
    reopen /dev/ser1

    display_msg "================================================================"
    display_msg " LATCH + GOVERNOR -- EXPERIMENTAL in-guest inference profile"
    display_msg " Target: QEMU ARMv8 Virt Machine | 4x Cortex-A76 | EL2 VHE | GICv2"
    display_msg " Contract: contracts/governor_servo.manifest (UNCHANGED)"
    display_msg "================================================================"

    # 2. Push compiled QNX 8.0 Security Policy into procnto
    secpolpush /proc/boot/secpol.bin

    # 3. Start system logger and pipe resource manager (required for qvm hostdev >"|...")
    on -T slogger2_t -C 1 /proc/boot/slogger2 &
    waitfor /dev/slog2 4

    on -T pipe_t -C 1 /proc/boot/pipe &
    waitfor /dev/pipe 4

    # 4. Start latchd on _cpu-0 in mock I2C mode (-n)
    #
    #    The SAME manifest as the scripted profile.  The supervisor cannot
    #    tell which profile is driving it -- that is the point: the trusted
    #    host applies the signed envelope to whatever the guest proposes,
    #    whether the proposal came from a compiled-in sequence or from a
    #    language model.
    on -T latchd_t -C 0 -p 63f /proc/boot/latchd -m /proc/boot/governor_servo.manifest -n &
    waitfor /dev/latch/proposal 4
    waitfor /dev/latch/actuator 4

    # 5. Start background evidence logger on _cpu-1
    on -T latchlog_t -C 1 /proc/boot/latchlog -m /proc/boot/governor_servo.manifest -d /dev/latch/actuator -o /dev/shmem/governor_tape.csv &

    # 6. Launch the QNX Hypervisor 8.0 guest VM.
    #
    #    The VM is started by `latch_guestd`, a narrowly-typed guest-lifecycle
    #    daemon, NOT directly by the boot script.  The reason is measured
    #    (2026-11-25, QEMU AArch64 target): `slay -9 qvm` from the operator
    #    shell works, but `on -T qvm_host_t ... qvm @qvmconf` is REFUSED with
    #    "on: Operation not permitted", because `operator_shell_t` holds no
    #    `settypeid` and no `spawn`.  Granting the operator shell that
    #    ability would collapse the "the operator shell is deliberately
    #    unprivileged" property, so the power to start the guest lives in
    #    one dedicated typed domain instead -- one that holds no actuator
    #    ability and no proposal-write right.
    #
    #    latch_guestd spawns the VM as a CHILD of type `qvm_host_t`, so the
    #    hypervisor gets exactly the abilities it got when the boot script
    #    started it directly.
    #
    #    CPU affinity: deliberately NOT constrained here.
    #    `on -C <n>` resolves to the predefined single-CPU cluster _cpu-<n>, and
    #    `on -R <mask>` resolves the mask to a predefined cluster too -- there is
    #    NO predefined cluster covering CPUs 2+3 together, so both
    #    `-C 2 -C 3` (mask 0xc) and `-R 0xc` fail with
    #    "Invalid cluster runmask specified for (/proc/boot/qvm)".
    #    Leaving the runmask unset lets qvm inherit the full CPU set, which is
    #    what the vCPU threads NEED in order to reach their pinned cores.
    #
    #    The actual isolation is enforced one level down, by the qvmconf:
    #        cpu _cpu-2 sched 8r
    #        cpu _cpu-3 sched 8r
    #    Those static vCPU pins are the documented hypervisor security property
    #    (the guest cannot change them -- it lacks the ability). latchd pins
    #    itself to _cpu-0 with ThreadCtl at SCHED_FIFO 63, and latch-ingest /
    #    latchlog / ksh stay on _cpu-1, so the guest cannot reach the decision
    #    core. The guest vCPUs run at priority 8, far below latchd's 63.
    on -T latch_guestd_t /proc/boot/latch_guestd -q /proc/boot/qvm -c /proc/boot/latch_qemu_infer.qvmconf &
    waitfor /dev/latch/guestctl 4

    # 7. Interactive operator shell on _cpu-1
    [+session] on -T operator_shell_t -C 1 -p 10r /proc/boot/ksh
}

[type=link] /bin/sh = /proc/boot/ksh
[type=link] /dev/console = /dev/ser1
[type=link] /tmp = /dev/shmem

ldqnx-64.so.2
libc.so
libm.so
libgcc_s.so.1
libsecpol.so.1
libqh.so.1
libslog2.so.1
libslog2parse.so.1
libfdt.so.1

[perms=0755] /lib/dll/qvm/vdev-virtio-console.so = vdev-virtio-console.so
[perms=0755] /lib/dll/qvm/vdev-virtio-blk.so = vdev-virtio-blk.so
[perms=0755] /lib/dll/qvm/vdev-shmem.so = vdev-shmem.so
[perms=0755] /lib/dll/qvm/vdev-pl011.so = vdev-pl011.so

[perms=0755] secpolpush
[perms=0755] slogger2
[perms=0755] slog2info
[perms=0755] pipe
[perms=0755] devc-serpl011
[perms=0755] /proc/boot/qvm = qvm
[perms=0755] on
[perms=0755] ability
[perms=0755] pidin
[perms=0755] slay
[perms=0755] ksh
[perms=0755] waitfor

[uid=0 gid=0 perms=0750] /proc/boot/latchd = build/nto-aarch64-le/latchd
[uid=0 gid=0 perms=0750] /proc/boot/latch_verify = build/nto-aarch64-le/latch_verify
[uid=0 gid=0 perms=0755] /proc/boot/latch-ingest = build/nto-aarch64-le/latch-ingest
[uid=0 gid=0 perms=0750] /proc/boot/latchctl = build/nto-aarch64-le/latchctl
[uid=0 gid=0 perms=0755] /proc/boot/latchlog = build/nto-aarch64-le/latchlog
[uid=0 gid=0 perms=0755] /proc/boot/latch_guestd = build/nto-aarch64-le/latch_guestd
[uid=0 gid=0 perms=0644] /proc/boot/governor_servo.manifest = ./contracts/governor_servo.manifest
[uid=0 gid=0 perms=0644] /proc/boot/governor_servo.manifest.sha256 = ./contracts/governor_servo.manifest.sha256
[uid=0 gid=0 perms=0644] /proc/boot/latch_qemu_infer.qvmconf = ./latch_qemu_infer.qvmconf
[uid=0 gid=0 perms=0644] /proc/boot/secpol.bin = build/secpol.bin
[perms=0644] /proc/boot/linux-guest.Image = ${GUEST_IMAGE}
[perms=0644] /proc/boot/governor-linux-guest-infer.initrd = ${INFER_GUEST_INITRD}
# The read-only asset disk: the language model and the inference program.
# It is a BUILD INPUT, not a repository artifact: build it with
# tools/build_guest_disk.sh.
[perms=0644] /proc/boot/latch_guest_disk.img = ${GUEST_DISK}
