################################################################################
# qnx/latch_qemu.build
#
# QNX SDP 8.0 OS Image Buildfile for LATCH on QEMU AArch64 (ARMv8 Virt Machine)
# Target Platform : QEMU `virt` machine (ARM Cortex-A76, GICv2, VirtIO, EL2 VHE)
# Hypervisor      : QNX Hypervisor 8.0 (AArch64 EL2 + GICv2 0x08000000 / 0x08010000)
################################################################################

[image=0x40080000]
[virtual=aarch64le,raw] boot = {
    startup-qemu-virt -v -Q enable
    PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin
    LD_LIBRARY_PATH=/proc/boot:/lib:/usr/lib:/lib/dll:/lib/dll/qvm
    procnto-smp-instr -v
}

[+script] startup-script = {
    procmgr_symlink ../../proc/boot/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2

    # 1. Serial console (PL011 UART at 0x09000000, IRQ 33 on QEMU virt)
    devc-serpl011 -e -F -b115200 0x09000000,33
    waitfor /dev/ser1 4
    reopen /dev/ser1

    display_msg "================================================================"
    display_msg " LATCH — Last Authority for Trusted Control Handoff (QNX 8.0)"
    display_msg " Target: QEMU ARMv8 Virt Machine | 4x Cortex-A76 | EL2 VHE | GICv2"
    display_msg "================================================================"

    # 2. Push compiled QNX 8.0 Security Policy into procnto
    secpolpush /proc/boot/secpol.bin

    # 3. Start system logger and pipe resource manager (required for qvm hostdev >"|...")
    on -T slogger2_t -C 1 /proc/boot/slogger2 &
    waitfor /dev/slog2 4

    on -T pipe_t -C 1 /proc/boot/pipe &
    waitfor /dev/pipe 4

    # 4. Start latchd on _cpu-0 in mock I2C mode (-n)
    on -T latchd_t -C 0 -p 63f /proc/boot/latchd -m /proc/boot/latch.manifest -n &
    waitfor /dev/latch/proposal 4
    waitfor /dev/latch/actuator 4

    # 5. Start background evidence logger on _cpu-1
    on -T latchlog_t -C 1 /proc/boot/latchlog -m /proc/boot/latch.manifest -d /dev/latch/actuator -o /dev/shmem/latch_tape.csv &

    # 6. Launch QNX Hypervisor 8.0 guest VM.
    #
    #    CPU affinity: deliberately NOT constrained here.
    #    `on -C <n>` resolves to the predefined single-CPU cluster _cpu-<n>, and
    #    `on -R <mask>` resolves the mask to a predefined cluster too -- there is
    #    NO predefined cluster covering CPUs 2+3 together, so both
    #    `-C 2 -C 3` (mask 0xc) and `-R 0xc` fail with
    #    "Invalid cluster runmask specified for (/proc/boot/qvm)".
    #    Leaving the runmask unset lets qvm inherit the full CPU set, which is
    #    what the vCPU threads NEED in order to reach their pinned cores.
    #
    #    The actual isolation is enforced one level down, by the qvmconf:
    #        cpu _cpu-2 sched 8r
    #        cpu _cpu-3 sched 8r
    #    Those static vCPU pins are the documented hypervisor security property
    #    (the guest cannot change them -- it lacks the ability). latchd pins
    #    itself to _cpu-0 with ThreadCtl at SCHED_FIFO 63, and latch-ingest /
    #    latchlog / ksh stay on _cpu-1, so the guest cannot reach the decision
    #    core. The guest vCPUs run at priority 8, far below latchd's 63.
    on -T qvm_host_t /proc/boot/qvm @/proc/boot/latch_qemu_virt.qvmconf &

    # 7. Interactive operator shell on _cpu-1
    [+session] on -T operator_shell_t -C 1 -p 10r /proc/boot/ksh
}

[type=link] /bin/sh = /proc/boot/ksh
[type=link] /dev/console = /dev/ser1
[type=link] /tmp = /dev/shmem

ldqnx-64.so.2
libc.so
libm.so
libgcc_s.so.1
libsecpol.so.1
libqh.so.1
libslog2.so.1
libslog2parse.so.1
libfdt.so.1

[perms=0755] /lib/dll/qvm/vdev-virtio-console.so = vdev-virtio-console.so
[perms=0755] /lib/dll/qvm/vdev-shmem.so = vdev-shmem.so
[perms=0755] /lib/dll/qvm/vdev-pl011.so = vdev-pl011.so

[perms=0755] secpolpush
[perms=0755] slogger2
[perms=0755] slog2info
[perms=0755] pipe
[perms=0755] devc-serpl011
[perms=0755] /proc/boot/qvm = qvm
[perms=0755] on
[perms=0755] ability
[perms=0755] pidin
[perms=0755] slay
[perms=0755] ksh
[perms=0755] waitfor

[uid=0 gid=0 perms=0750] /proc/boot/latchd = build/nto-aarch64-le/latchd
[uid=0 gid=0 perms=0750] /proc/boot/latch_verify = build/nto-aarch64-le/latch_verify
[uid=0 gid=0 perms=0755] /proc/boot/latch-ingest = build/nto-aarch64-le/latch-ingest
[uid=0 gid=0 perms=0750] /proc/boot/latchctl = build/nto-aarch64-le/latchctl
[uid=0 gid=0 perms=0755] /proc/boot/latchlog = build/nto-aarch64-le/latchlog
[uid=0 gid=0 perms=0644] /proc/boot/latch.manifest = ./latch.manifest
[uid=0 gid=0 perms=0644] /proc/boot/latch.manifest.sha256 = ./latch.manifest.sha256
[uid=0 gid=0 perms=0644] /proc/boot/latch_qemu_virt.qvmconf = ./latch_qemu_virt.qvmconf
[uid=0 gid=0 perms=0644] /proc/boot/secpol.bin = build/secpol.bin
[perms=0644] /proc/boot/linux-guest.Image = ${GUEST_IMAGE}
[perms=0644] /proc/boot/linux-guest.initrd = ${GUEST_INITRD}
