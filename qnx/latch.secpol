# ==============================================================================
# latch/qnx/latch.secpol
#
# LATCH — Last Authority for Trusted Control Handoff
# QNX SDP 8.0 Security Policy Definition (compiled via `secpolcompile`)
#
# Valid QNX SDP 8.0 secpolcompile grammar:
#   - `type <name>;`
#   - `ability <name>;`
#   - `allow <type> self:ability { ... };`
#   - `allow_attach <type> <path>;`
#   - `allow <client> <server>:channel connect;`
#
# Enforces Principle of Least Privilege:
#   1. Declares custom ability "latch/actuator" (`flags=0` uninherited default).
#   2. Restricts /dev/i2c1 attachment to `i2c_t` and connection to `latchd_t`.
#   3. Restricts /dev/latch/proposal & /dev/latch/actuator attachment to `latchd_t`.
#   4. Grants `latch/actuator` ability only to `latchd_t`, `latchctl_t`, and admin checks.
#   5. Denies `qvm_host_t` and `latch_ingest_t` any connection or ability toward actuators.
# ==============================================================================

# 1. Process Types
type latchd_t;
type latch_ingest_t;
type latchctl_t;
type latchlog_t;
type latch_verify_t;
type i2c_t;
type qvm_host_t;
type slogger2_t;
type pipe_t;

# 2. Custom Ability Declaration (created at runtime via procmgr_ability_create)
ability latch/actuator;
# Looked up by the pipe resource manager before it registers as pipe handler
ability iofunc/exec;

# 3. Process Abilities (self:ability grants)
allow latchd_t self:ability {
    able_create
    mem_lock
    pathspace
    priority
    runstate
    public_channel
    latch/actuator
};

allow latchctl_t self:ability {
    nonroot
    latch/actuator
};

# Ingest runs least-privilege without latch/actuator, hardware I/O, or able_create
allow latch_ingest_t self:ability {
    nonroot
};

allow i2c_t self:ability {
    io
    interrupt
    pathspace
    public_channel
};

allow qvm_host_t self:ability {
    hyp
    io
    interrupt
    mem_lock
    mem_phys
    map_fixed
    priority
    pathspace
    public_channel
    rsrcdbmgr
    schedule
    timer
    event
    fork
    spawn
    settypeid
};

# 4. Pathspace Ownership (allow_attach)
allow_attach latchd_t /dev/latch/proposal;
allow_attach latchd_t /dev/latch/actuator;
allow_attach i2c_t /dev/i2c1;
allow_attach slogger2_t /dev/slog;
allow_attach slogger2_t /dev/slog2;
allow_attach slogger2_t /dev/slog2/*;
allow_attach slogger2_t /dev/slog2_notify;
allow_attach qvm_host_t /dev/qvm;
allow_attach qvm_host_t /dev/qvm/*;
allow_attach qvm_host_t /dev/qvm/*/*;

# 4b. slogger2 daemon abilities (attaches /dev/slog2 for system logging)
allow slogger2_t self:ability {
    pathspace
    public_channel
};

# 4c. pipe resource manager (attaches /dev/pipe; needed for qvm `hostdev >"|..."`)
allow pipe_t self:ability {
    able_create
    pathspace
    public_channel
    iofunc/exec
};

allow_attach pipe_t /dev/pipe;
allow_attach pipe_t pipe:/;
allow_attach pipe_t pipe:/...;

# qvm's pipe() opens the pipe manager's channel
allow qvm_host_t pipe_t:channel connect;

# 5. Inter-Process Channel Connection Rules
# Notice: qvm_host_t has NO channel connect rule to i2c_t or latchd_t
allow latchd_t i2c_t:channel connect;
allow latch_ingest_t latchd_t:channel connect;
allow latchctl_t latchd_t:channel connect;
allow latchlog_t latchd_t:channel connect;
allow latch_verify_t latchd_t:channel connect;

# Clients of the system log (incl. qvm's `logger` config)
allow latchd_t slogger2_t:channel connect;
allow latchctl_t slogger2_t:channel connect;
allow latchlog_t slogger2_t:channel connect;
allow latch_verify_t slogger2_t:channel connect;
allow qvm_host_t slogger2_t:channel connect;
