# ==============================================================================
# latch/qnx/latch.secpol
#
# LATCH — Last Authority for Trusted Control Handoff
# QNX SDP 8.0 Security Policy Definition (compiled via `secpolcompile`)
#
# Valid QNX SDP 8.0 secpolcompile grammar:
#   - `type <name>;`
#   - `ability <name>;`
#   - `allow <type> self:ability { ... };`
#   - `allow_attach <type> <path>;`
#   - `allow_attach <type> <path> <channel_type>;`
#   - `allow <client> <server>:channel connect;`
#
# Enforces Principle of Least Privilege:
#   1. Declares custom ability "latch/actuator" (`flags=0` uninherited default).
#   2. Restricts /dev/i2c1 attachment to `i2c_t` and connection to `latchd_t`.
#   3. Restricts /dev/latch/proposal & /dev/latch/actuator attachment to `latchd_t`.
#   4. Grants `latch/actuator` ability only to `latchd_t`, `latchctl_t`, and admin checks.
#   5. Denies `qvm_host_t` and `latch_ingest_t` any connection or ability toward actuators.
#   6. Confines the guest-lifecycle daemon (`latch_guestd_t`) to ONE channel type
#      (`guest_ctl_t`) that grants no actuator ability and no proposal access.
# ==============================================================================

# 1. Process Types
type latchd_t;
type latch_ingest_t;
type latchctl_t;
type latchlog_t;
type latch_verify_t;
type i2c_t;
type qvm_host_t;
type slogger2_t;
type pipe_t;
# The guest-lifecycle daemon (U-1). It OWNS the guest VM process and is the
# only process that may spawn one. It holds NO `latch/actuator` ability, no
# `latch/propose` ability, and no right to connect to the supervisor's own
# channels -- so it cannot propose motion and cannot actuate. Its only
# power is to start and stop the guest that the supervisor is supervising.
type latch_guestd_t;
# A CHANNEL type, not a process type. `allow_attach ... guest_ctl_t` makes
# the channel latch_guestd attaches at /dev/latch/guestctl carry this type,
# and only the two process types listed in section 5 may connect to it.
type guest_ctl_t;
# The operator shell gets its OWN type. It deliberately does NOT receive
# `latch/actuator`, so the "a process without the ability gets EPERM" demo
# does not depend on the shell happening to be untyped root.
type operator_shell_t;

# 2. Custom Ability Declaration (created at runtime via procmgr_ability_create)
ability latch/actuator;
ability latch/propose;
# Looked up by the pipe resource manager before it registers as pipe handler
ability iofunc/exec;

# 3. Process Abilities (self:ability grants)
allow latchd_t self:ability {
    able_create
    mem_lock
    pathspace
    priority
    runstate
    public_channel
    latch/actuator
};

allow latchctl_t self:ability {
    nonroot
    latch/actuator
};

# Ingest runs least-privilege without latch/actuator, hardware I/O, or able_create
allow latch_ingest_t self:ability {
    nonroot
    latch/propose
};

allow i2c_t self:ability {
    io
    interrupt
    pathspace
    public_channel
};

# latchlog: read-only evidence tape logger. It needs to open /dev/latch/actuator
# read-only and issue DCMD_LATCH_DUMP_TAPE. It does NOT hold `latch/actuator`
# (giving it that would make it a second keyholder and break the story).
allow latchlog_t self:ability {
    nonroot
    pathspace
    public_channel
};

# latch_verify: the on-target verification harness. It writes to
# /dev/latch/proposal and issues devctls on /dev/latch/actuator. It does NOT
# hold `latch/actuator` either -- its EPERM checks are the demo.
allow latch_verify_t self:ability {
    nonroot
    pathspace
    public_channel
    latch/propose
};

# The operator shell: an ordinary unprivileged domain with NO `latch/actuator`.
# `latchctl grant-check` run from this shell must print DENIED.
allow operator_shell_t self:ability {
    nonroot
    pathspace
    public_channel
};

allow qvm_host_t self:ability {
    hyp
    io
    interrupt
    mem_lock
    mem_phys
    map_fixed
    priority
    pathspace
    public_channel
    rsrcdbmgr
    schedule
    timer
    event
    fork
    spawn
    settypeid
};

# The guest-lifecycle daemon (U-1).
#
# It needs exactly four things:
#   pathspace + public_channel  -- to be a resource manager and attach its
#                                  node (same as every other daemon here)
#   spawn                        -- to start the guest VM child
#   settypeid:qvm_host_t         -- to give that child the hypervisor
#                                  type it needs, and ONLY that type
#
# It does NOT get `hyp`, `mem_phys`, `io`, `interrupt`, `rsrcdbmgr`,
# `timer`, `event`, `schedule`, `fork`, `latch/actuator` or
# `latch/propose`.  The hypervisor privileges belong to the CHILD it
# spawns; the daemon itself holds only the power to create and destroy
# that child.
allow latch_guestd_t self:ability {
    pathspace
    public_channel
    spawn
    settypeid:qvm_host_t
};

# 4. Pathspace Ownership (allow_attach)
allow_attach latchd_t /dev/latch/proposal;
allow_attach latchd_t /dev/latch/actuator;
allow_attach latchd_t /dev/governor;
allow_attach i2c_t /dev/i2c1;
allow_attach slogger2_t /dev/slog;
allow_attach slogger2_t /dev/slog2;
allow_attach slogger2_t /dev/slog2/*;
allow_attach slogger2_t /dev/slog2_notify;
allow_attach qvm_host_t /dev/qvm;
allow_attach qvm_host_t /dev/qvm/*;
allow_attach qvm_host_t /dev/qvm/*/*;

# The guest-lifecycle control node.  The THIRD argument is the CHANNEL
# TYPE the attached channel takes: `guest_ctl_t`.  It is deliberately not
# `latch_guestd_t`, so the daemon's own internal channels keep the daemon's
# process type and no client rule can reach them.
allow_attach latch_guestd_t /dev/latch/guestctl guest_ctl_t;

# 4b. slogger2 daemon abilities (attaches /dev/slog2 for system logging)
allow slogger2_t self:ability {
    pathspace
    public_channel
};

# 4c. pipe resource manager (attaches /dev/pipe; needed for qvm `hostdev >"|..."`)
allow pipe_t self:ability {
    able_create
    pathspace
    public_channel
    iofunc/exec
};

allow_attach pipe_t /dev/pipe;
allow_attach pipe_t pipe:/;
allow_attach pipe_t pipe:/...;

# qvm's pipe() opens the pipe manager's channel
allow qvm_host_t pipe_t:channel connect;

# 5. Inter-Process Channel Connection Rules
# Notice: qvm_host_t has NO channel connect rule to i2c_t or latchd_t
allow latchd_t i2c_t:channel connect;
allow latch_ingest_t latchd_t:channel connect;
allow latchctl_t latchd_t:channel connect;
allow latchlog_t latchd_t:channel connect;
allow latch_verify_t latchd_t:channel connect;
allow operator_shell_t latchd_t:channel connect;

# Clients of the system log (incl. qvm's `logger` config)
allow latchd_t slogger2_t:channel connect;
allow latchctl_t slogger2_t:channel connect;
allow latchlog_t slogger2_t:channel connect;
allow latch_verify_t slogger2_t:channel connect;
allow operator_shell_t slogger2_t:channel connect;
allow qvm_host_t slogger2_t:channel connect;

# 6. Guest-lifecycle control channel (U-1)
#
# `guest_ctl_t` is a CHANNEL type.  Only the two process types below may
# connect to it; every other type is refused at connect time.
#
# `operator_shell_t` is here because `latchctl` inherits the type of
# whatever spawned it, and the operator's `latchctl` is spawned by the
# operator shell.  This grant is NARROW: it permits a connection to the
# guest-control channel and nothing else.  It does NOT give the operator
# shell `latch/actuator` (so `latchctl hold` is still refused), and it
# does NOT let the operator shell connect to the proposal node (whose
# channel type is `latchd_t`, and for which there is no
# `operator_shell_t` rule).
#
# The operator could already stop the guest with `slay -9 qvm`; this grant
# adds the ability to START it again, with a fixed binary and a fixed
# configuration that the operator cannot choose.
allow latchctl_t guest_ctl_t:channel connect;
allow operator_shell_t guest_ctl_t:channel connect;
