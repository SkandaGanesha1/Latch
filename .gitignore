# ==============================================================================
# LATCH .gitignore
# ==============================================================================

# Build artifacts
qnx/build/
# ROOTED at the repository root on purpose. A bare `build/` pattern matches
# ANY directory of that name at ANY depth -- which silently excluded
# `docs/evidence/build/` (the mkifs listing and the initramfs forensics)
# from the published archive while the index listed it as if it were there.
# The evidence archive must be published.
/build/
*.o
*.so
*.so.*
*.a
*.sym
*.ifs
*.bin
*.qcow2
*.vmdk
*.img

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Runtime logs and process files
*.log
*.pid
qemu.pid

# OS & Editor generated files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# QNX Agent Target Config (local SSH connection details)
TARGET.md


# Agent-tooling side-plot: internal only, never published
.agents/
